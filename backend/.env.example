# Backend local secrets — copy to `.env` and fill in real values.
# `.env` is git-ignored; this template is committed. Never commit `.env`.
#
# Gradle does NOT auto-load .env — use `./run-gemini.sh` (which sources this)
# or export these vars manually before `./gradlew bootRun`.

# --- Image/text provider: Google Gemini -------------------------------------
# Get a key at https://aistudio.google.com/apikey (Generative Language API).
# Activating the `gemini` profile is required — the key alone does not flip it.
GEMINI_API_KEY=

# Optional overrides (defaults live in application.yml — leave blank to use them)
# GEMINI_MODEL_ID=gemini-3.1-flash-image-preview
# GEMINI_TEXT_MODEL_ID=gemini-2.5-flash
# GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_REQUEST_TIMEOUT_MS=25000
