# Java / Gradle
.gradle
build
out

# Gradle wrapper is intentionally NOT committed. Use a system Gradle
# (`brew install gradle`, `sdk install gradle`, etc.) to run the build,
# or bootstrap a local-only wrapper with `gradle wrapper --gradle-version 9.4`
# in backend/. The Docker build uses the official `gradle` image.
gradle/
gradlew
gradlew.bat

# Local secrets — real API keys / credentials. Never commit.
# `.env.example` is the committed template; `.env` holds real values.
.env
.env.*
!.env.example
backend/run-gemini.sh

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.iml
.DS_Store

# Design mock — input for initial POC only; delete after POC is scaffolded. Never commit.
aiavatar-mock.html

# Terraform — never commit state, lockfile is fine to commit but plan outputs aren't.
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfplan
deploy/terraform/crash.log
deploy/terraform/terraform.tfvars
deploy/terraform/*.auto.tfvars
